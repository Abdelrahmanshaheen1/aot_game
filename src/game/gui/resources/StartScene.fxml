<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.stage.Stage?>

<Stage xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="game.gui.Controller">
    <scene>
        <Scene>
            <AnchorPane prefHeight="286.0" prefWidth="520.0">
            <children>
               <Button fx:id="exit_button" layoutY="2.0" mnemonicParsing="false" onAction="#exit" text="Exit" textFill="#ec0c0c" />
               <Button fx:id="start_easy" layoutX="195.0" layoutY="105.0" mnemonicParsing="false" onAction="#switchToEasyGameScene" text="Start in easy mode" />
               <Button fx:id="start_hard" layoutX="195.0" layoutY="150.0" mnemonicParsing="false" onAction="#switchToHardGameScene" text="Start in hard mode" />
               <TextArea layoutX="133.0" layoutY="214.0" prefHeight="37.0" prefWidth="267.0" text="Choose weapons and try to defeat the titans!" />
               <Label layoutX="191.0" layoutY="28.0" text="Attack on titan: Utopia!" />
            </children></AnchorPane>
        </Scene>
    </scene>
</Stage>
